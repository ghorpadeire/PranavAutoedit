{
  "manifestVersion": 5,
  "id": "com.pranavautoedit.fillerremover",
  "name": "Filler Remover",
  "version": "1.0.0",
  "host": [
    {
      "app": "PPRO",
      "minVersion": "22.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": {
        "default": "Filler Remover"
      },
      "main": "index.html",
      "minimumSize": { "width": 300, "height": 500 },
      "maximumSize": { "width": 800, "height": 2000 },
      "preferredDockedSize": { "width": 350, "height": 620 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://localhost:8000",
        "https://localhost:8000",
        "https://*.railway.app",
        "https://*.onrender.com"
      ]
    },
    "localFileSystem": "request",
    "clipboard": "readwrite"
  }
}
