{
  "manifestVersion": 5,
  "id": "com.pranavautoedit.fillerremover",
  "name": "Filler Remover",
  "shortname": "FillerRemover",
  "version": "1.0.2",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.1.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": {
        "default": "Filler Remover"
      },
      "minimumSize": { "width": 300, "height": 500 },
      "maximumSize": { "width": 800, "height": 2000 },
      "preferredDockedSize": { "width": 350, "height": 620 },
      "preferredFloatingSize": { "width": 350, "height": 620 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://localhost:8000",
        "https://localhost:8000",
        "https://*.railway.app",
        "https://*.onrender.com"
      ]
    },
    "localFileSystem": "request",
    "clipboard": "readAndWrite"
  }
}
